// Prisma 6. The CLI loads .env from the project root automatically
// (there is intentionally no prisma.config.ts, which would disable that).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (runtime)
  directUrl = env("DIRECT_URL") // Neon direct connection (migrations)
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  quizAttempts QuizAttempt[]
  progress     UserProgress[]
}

// Keyed by email so a User row is only created after a successful verify.
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

// The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum Genre {
  FOLKTALE
  ADVENTURE
  FAMILY
  FRIENDSHIP
  MYSTERY
  DAILY_LIFE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

model Story {
  id        String        @id @default(cuid())
  slug      String        @unique
  titleBn   String
  titleEn   String
  summaryBn String
  summaryEn String
  genre     Genre
  level     Int // 1 = beginner … 5 = advanced
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  chapters  Chapter[]

  @@index([status, createdAt])
  @@index([genre])
}

// Guests may read chapters with requiresLogin = false; see features/stories/access.ts.
model Chapter {
  id            String            @id @default(cuid())
  storyId       String
  story         Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order         Int
  titleBn       String
  titleEn       String
  requiresLogin Boolean           @default(true)
  status        PublishStatus     @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sentences     ChapterSentence[]
  words         VocabularyWord[]
  quizQuestions QuizQuestion[]
  orderTasks    SentenceOrderTask[]
  progress      UserProgress[]
  notes         ChapterNote[]

  // Also serves lookups by storyId (leading column).
  @@unique([storyId, order])
}

model ChapterSentence {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int
  bn        String
  en        String

  @@unique([chapterId, order])
}

enum TenseKind {
  SIMPLE
  CONTINUOUS
  PERFECT
}

enum TenseTime {
  PRESENT
  PAST
  FUTURE
}

// "Important words" shown under a chapter's sentences.
model VocabularyWord {
  id              String  @id @default(cuid())
  chapterId       String
  chapter         Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order           Int // display order in the panel
  word            String // lowercase base form, e.g. "fly"
  meaningBn       String
  pronunciationBn String // e.g. "ফ্লাই"
  exampleEn       String
  exampleBn       String

  @@unique([chapterId, word])
  // Also serves lookups by chapterId (leading column).
  @@unique([chapterId, order])
  @@index([word])
}

// Keyed by the base-form string (no FK), so every chapter using the word shares its forms.
model WordForm {
  id        String    @id @default(cuid())
  word      String // matches VocabularyWord.word
  kind      TenseKind
  time      TenseTime
  form      String // he/she form, e.g. "flies", "is flying", "has flown"
  exampleEn String

  // One cell per tense; also serves lookups by word (leading column).
  @@unique([word, time, kind])
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_GAP
}

// correctIndex is never sent to the browser before the user answers.
model QuizQuestion {
  id           String        @id @default(cuid())
  chapterId    String
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order        Int
  type         QuestionType
  promptBn     String
  promptEn     String // FILL_GAP marks the blank with "___"
  options      Json // string[]
  correctIndex Int
  attempts     QuizAttempt[]

  // Also serves lookups by chapterId (leading column).
  @@unique([chapterId, order])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenIndex Int
  correct     Boolean
  createdAt   DateTime     @default(now())

  // Dashboard: distinct questions a user answered correctly.
  @@index([userId, correct, questionId])
  @@index([questionId])
}

// Sentence-ordering game: the English sentence is split into shuffled words on the server.
model SentenceOrderTask {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int
  promptBn  String
  en        String

  @@unique([chapterId, order])
}

enum NoteKind {
  PRONUNCIATION
  GRAMMAR
}

// Pronunciation and grammar notes shown under a chapter's words; rendered as plain text.
model ChapterNote {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int
  kind      NoteKind
  titleBn   String
  titleEn   String
  bodyBn    String
  exampleEn String

  // Also serves lookups by chapterId (leading column).
  @@unique([chapterId, order])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([userId, completedAt])
  @@index([chapterId])
}
