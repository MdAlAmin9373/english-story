// Prisma 6. The CLI loads .env from the project root automatically
// (there is intentionally no prisma.config.ts, which would disable that).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (runtime)
  directUrl = env("DIRECT_URL") // Neon direct connection (migrations)
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
}

// Keyed by email so a User row is only created after a successful verify.
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

// The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
